# Copia este archivo como .env y rellénalo. NUNCA subas el .env a GitHub.

# Token del bot que te da @BotFather
TELEGRAM_TOKEN=

# Token de tu integración interna de Notion (empieza por ntn_ o secret_)
NOTION_TOKEN=

# Tu chat con el bot. Déjalo vacío, arranca el bot, mándale /start y te lo dice.
CHAT_ID=

# Hora del resumen y los avisos diarios
HORA_RESUMEN=09:00

# Zona horaria (formato IANA, p. ej. Europe/Madrid, America/Mexico_City, America/Argentina/Buenos_Aires)
ZONA_HORARIA=Europe/Madrid

# Días de antelación con los que empiezan los avisos diarios
DIAS_AVISO=7

# Los rellena solo "python setup_notion.py <enlace de tu página>"
EXAMENES_DB_ID=
ASIGNATURAS_DB_ID=
NOTAS_RAPIDAS_PAGE_ID=
